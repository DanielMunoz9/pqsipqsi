# Variables de entorno para Bellator / Valhala
# Copia este archivo como .env y configura tus valores reales

# Dominio publico del sitio
PUBLIC_HOST=bellatorrpg.online

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-supabase-key-aqui

# Panel admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave-super-segura
ADMIN_JWT_SECRET=cambia-este-secreto-super-seguro-min-32-caracteres

# App
APP_ENV=production
PORT=8080

# Azure Speech narrator
PUBLIC_TTS_ENABLED=false
TTS_MAX_CHARS=700
TTS_MIN_INTERVAL_SECONDS=20
AZURE_SPEECH_KEY=tu-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_DEFAULT_VOICE=es-CO-SalomeNeural
AZURE_SPEECH_OUTPUT_FORMAT=audio-24khz-96kbitrate-mono-mp3

# Supabase Storage para uploads persistentes en hosts efimeros
SUPABASE_STORAGE_BUCKET=bellator-uploads
SUPABASE_STORAGE_FOLDER=uploads
SUPABASE_STORAGE_KEY=tu-supabase-storage-key
